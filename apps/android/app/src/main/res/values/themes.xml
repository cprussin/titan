<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: Titan's dark background, so launch never flashes white. -->
    <style name="Theme.Titan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/titan_background</item>
        <item name="android:windowSplashScreenBackground">@color/titan_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
