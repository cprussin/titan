# Postgres connection string.
# Neon: use the POOLED connection string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/titan?sslmode=require

# Google OAuth sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID → Web application). Register a SINGLE authorized redirect
# URI: `${AUTH_PROXY_URL}/api/auth/callback` (see AUTH_PROXY_URL below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of the Google account email(s) allowed to sign in.
GOOGLE_ALLOWED_EMAILS=you@example.com

# Base URL of the PRODUCTION deployment (no trailing slash). Google's one
# redirect URI is registered here, and every deployment — production and
# preview alike — routes its OAuth callback through it. Set the SAME value in
# all environments. Locally, use http://localhost:3000.
AUTH_PROXY_URL=https://your-app.vercel.app
# Optional. Host suffix that lets preview deployments finish sign-in. Set it to
# your Vercel preview suffix (e.g. `-your-team.vercel.app`) so only your own
# previews can receive a session; leave blank to allow production only.
AUTH_PREVIEW_HOST_SUFFIX=
# Signs the session cookie and sign-in tokens. Any random string, at least 16
# characters (e.g. `openssl rand -hex 32`). Use the SAME value in all
# environments so previews and production can verify each other's handoffs.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Concept2 Logbook OAuth2 (optional — leave blank to disable the integration).
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
CONCEPT2_REDIRECT_URI=https://your-app.vercel.app/api/concept2/callback
